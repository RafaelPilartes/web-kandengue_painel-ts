# Apache (cPanel): o painel é uma SPA com rotas no cliente
# (/pricing/profiles, /users/drivers/…). Um pedido directo a uma rota tem
# de servir o index.html; ficheiros e pastas que existem servem-se tal
# como estão. Substitui o redirect que o Netlify fazia.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Os ficheiros em /assets levam hash no nome: podem ficar em cache um ano.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|svg|webp|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
