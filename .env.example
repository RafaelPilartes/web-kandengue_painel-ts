VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_GOOGLE_API_KEY=

# URL da API Fastify. Em dev aponta ao Fastify local, senão o ID token do
# emulador é rejeitado pela API de produção.
VITE_API_URL=http://localhost:3000

# Em `npm run dev` o painel liga-se aos emuladores locais por omissão —
# apontar para produção por engano é pior do que o contrário.
# Põe `false` para falar com produção a sério.
VITE_USE_EMULATOR=
